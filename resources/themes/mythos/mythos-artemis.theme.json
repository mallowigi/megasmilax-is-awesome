{
  "name": "Mythos Artemis",
  "dark": true,
  "author": "Mythos",
  "editorScheme": "/themes/mythos-artemis.xml",
  "colors": {
    "bg": "#1B1F27",
    "bg2": "#242932",
    "bg3": "#2F3540",
    "bg4": "#3A4250",
    "fg": "#D8E0D8",
    "fgMuted": "#7A8A84",
    "border": "#2A303A",
    "accent": "#A8D8C8",
    "accentHover": "#C0E4D6",
    "accent2": "#C8D4DC",
    "selection": "#384248",
    "caret": "#A8D8C8",
    "error": "#E0727A",
    "warn": "#D4C894",
    "info": "#C8D4DC",
    "success": "#A8D8C8"
  },
  "ui": {
    "*": {
      "background": "bg",
      "foreground": "fg",
      "infoForeground": "fgMuted",
      "selectionBackground": "selection",
      "selectionForeground": "fg",
      "selectionInactiveBackground": "bg3",
      "selectionInactiveForeground": "fg",
      "disabledBackground": "bg2",
      "disabledForeground": "fgMuted",
      "acceleratorForeground": "accent",
      "acceleratorSelectionForeground": "accent",
      "borderColor": "border",
      "disabledBorderColor": "bg3",
      "focusColor": "accent",
      "focusedBorderColor": "accent",
      "errorForeground": "error"
    },
    "ActionButton": { "hoverBackground": "bg3", "hoverBorderColor": "bg3", "pressedBackground": "bg4", "pressedBorderColor": "bg4" },
    "Borders": { "color": "border", "ContrastBorderColor": "bg" },
    "Button": {
      "startBackground": "bg3", "endBackground": "bg3",
      "startBorderColor": "border", "endBorderColor": "border",
      "foreground": "fg", "disabledBorderColor": "bg3",
      "default": {
        "startBackground": "accent", "endBackground": "accent",
        "startBorderColor": "accent", "endBorderColor": "accent",
        "foreground": "bg", "focusColor": "accentHover", "focusedBorderColor": "accentHover"
      }
    },
    "CheckBox": { "background": "bg", "foreground": "fg" },
    "ComboBox": {
      "background": "bg2", "nonEditableBackground": "bg2",
      "ArrowButton": { "background": "bg2", "nonEditableBackground": "bg2", "iconColor": "accent", "disabledIconColor": "fgMuted" }
    },
    "CompletionPopup": { "matchForeground": "accent", "selectionBackground": "selection", "selectionInactiveBackground": "bg3" },
    "Component": {
      "focusColor": "accent", "focusedBorderColor": "accent",
      "borderColor": "border", "disabledBorderColor": "bg3",
      "errorFocusColor": "error", "inactiveErrorFocusColor": "error",
      "warningFocusColor": "warn", "inactiveWarningFocusColor": "warn"
    },
    "Counter": { "background": "accent", "foreground": "bg" },
    "DefaultTabs": {
      "background": "bg", "hoverBackground": "bg2", "underlinedTabBackground": "bg2",
      "underlineColor": "accent", "inactiveUnderlineColor": "bg4", "borderColor": "border"
    },
    "EditorPane": {
      "background": "bg", "foreground": "fg", "caretForeground": "caret",
      "selectionBackground": "selection", "selectionForeground": "fg"
    },
    "EditorTabs": {
      "background": "bg", "hoverBackground": "bg2", "underlinedTabBackground": "bg2",
      "underlineColor": "accent", "inactiveUnderlineColor": "bg4", "borderColor": "border"
    },
    "FileColor": { "Yellow": "#2E2E17", "Green": "#1E2E1E", "Blue": "#1E283E", "Violet": "#2A1E36", "Orange": "#2E2417", "Rose": "#2E1D24" },
    "Link": {
      "activeForeground": "accent", "hoverForeground": "accentHover",
      "pressedForeground": "accentHover", "visitedForeground": "accent2", "secondaryForeground": "accent2"
    },
    "Menu": { "background": "bg2", "foreground": "fg", "selectionBackground": "selection", "selectionForeground": "fg", "borderColor": "border" },
    "MenuBar": { "background": "bg", "foreground": "fg", "selectionBackground": "selection", "selectionForeground": "fg", "borderColor": "border" },
    "MenuItem": {
      "background": "bg2", "foreground": "fg",
      "selectionBackground": "selection", "selectionForeground": "fg",
      "disabledForeground": "fgMuted", "acceleratorForeground": "accent", "acceleratorSelectionForeground": "accent"
    },
    "PopupMenu": {
      "background": "bg2", "foreground": "fg",
      "selectionBackground": "selection", "selectionForeground": "fg"
    },
    "Notification": {
      "background": "bg2", "borderColor": "border", "foreground": "fg",
      "errorBackground": "#3E1E24", "errorBorderColor": "error", "errorForeground": "fg",
      "ToolWindow": {
        "informativeBackground": "bg2", "informativeForeground": "fg", "informativeBorderColor": "info",
        "warningBackground": "bg2", "warningForeground": "fg", "warningBorderColor": "warn",
        "errorBackground": "bg2", "errorForeground": "fg", "errorBorderColor": "error"
      }
    },
    "Panel": { "background": "bg", "foreground": "fg" },
    "Popup": {
      "background": "bg2", "foreground": "fg",
      "Header.activeBackground": "bg2", "Header.inactiveBackground": "bg2",
      "borderColor": "border", "inactiveBorderColor": "border", "innerBorderColor": "border", "paintBorder": true,
      "Toolbar.Button.hoverBackground": "bg3",
      "Advertiser.background": "bg2", "Advertiser.foreground": "fgMuted", "Advertiser.borderColor": "border"
    },
    "ProgressBar": {
      "trackColor": "bg3", "progressColor": "accent",
      "indeterminateStartColor": "accent", "indeterminateEndColor": "accent2",
      "failedColor": "error", "failedEndColor": "error",
      "passedColor": "success", "passedEndColor": "success"
    },
    "ScrollBar": {
      "thumbColor": "#3A4450", "hoverThumbColor": "#4E5864",
      "Transparent.thumbColor": "#3A4450", "Transparent.hoverThumbColor": "#4E5864"
    },
    "SearchEverywhere": {
      "SearchField.background": "bg2", "SearchField.borderColor": "border",
      "Tab.selectedBackground": "selection", "Tab.selectedForeground": "accent"
    },
    "SearchMatch": { "startBackground": "accent", "endBackground": "accent" },
    "Separator": { "background": "bg2", "separatorColor": "border", "foreground": "border" },
    "SidePanel.background": "bg",
    "StatusBar": { "background": "bg2", "borderColor": "border", "hoverBackground": "bg3" },
    "TabbedPane": {
      "background": "bg", "foreground": "fg", "contentAreaColor": "border",
      "focusColor": "accent", "hoverColor": "bg2",
      "selectedBackground": "bg2", "selectedForeground": "accent",
      "underlineColor": "accent", "disabledUnderlineColor": "bg4"
    },
    "Table": {
      "background": "bg", "foreground": "fg", "gridColor": "bg2", "stripeColor": "bg2",
      "selectionBackground": "selection", "selectionForeground": "fg"
    },
    "TableHeader": { "background": "bg2", "foreground": "fg", "bottomSeparatorColor": "border" },
    "TextField": {
      "background": "bg2", "foreground": "fg", "caretForeground": "caret",
      "selectionBackground": "selection", "selectionForeground": "fg"
    },
    "TextArea": {
      "background": "bg2", "foreground": "fg", "caretForeground": "caret",
      "selectionBackground": "selection", "selectionForeground": "fg"
    },
    "ToggleButton": {
      "onBackground": "accent", "onForeground": "bg",
      "offBackground": "bg3", "offForeground": "fgMuted", "buttonColor": "fg"
    },
    "ToolTip": { "background": "bg2", "foreground": "fg", "borderColor": "border" },
    "ToolWindow": {
      "Button.hoverBackground": "bg3", "Button.selectedBackground": "bg3", "Button.selectedForeground": "accent",
      "HeaderTab.hoverBackground": "bg2", "HeaderTab.selectedInactiveBackground": "bg2", "HeaderTab.selectedBackground": "bg2",
      "HeaderTab.underlineColor": "accent", "HeaderTab.inactiveUnderlineColor": "bg4",
      "Header.background": "bg", "Header.inactiveBackground": "bg", "Header.borderColor": "border"
    },
    "Tree": {
      "background": "bg", "foreground": "fg",
      "selectionBackground": "selection", "selectionForeground": "fg",
      "selectionInactiveBackground": "bg3", "selectionInactiveForeground": "fg",
      "hash": "bg3", "modifiedItemForeground": "accent"
    },
    "ValidationTooltip": {
      "errorBackground": "#3E1E24", "errorBorderColor": "error",
      "warningBackground": "#3E3517", "warningBorderColor": "warn"
    },
    "VersionControl": {
      "GitLog.otherBranchesNodeBackground": "accent2",
      "FileHistory.Commit.selectedBranchBackground": "bg3"
    },
    "WelcomeScreen": {
      "background": "bg", "borderColor": "border", "separatorColor": "border",
      "Projects.background": "bg2", "Projects.selectionBackground": "selection",
      "Projects.selectionInactiveBackground": "bg3", "Projects.actions.background": "bg2"
    },
    "Window.border": "border"
  }
}
